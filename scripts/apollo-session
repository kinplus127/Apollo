#!/usr/bin/env bash
set -euo pipefail
ROOT="${APOLLO_ROOT:-/usr/local/share/apollo}"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
  if command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- bash "$ROOT/scripts/start-apollo.sh"
  fi
  echo "warning: dbus-run-session not found; continuing without a session bus" >&2
fi
exec bash "$ROOT/scripts/start-apollo.sh"
