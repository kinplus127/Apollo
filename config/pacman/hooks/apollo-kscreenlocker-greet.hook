[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/kscreenlocker_greet
Target = usr/libexec/kscreenlocker_greet

[Action]
Description = Apollo: reapply the lock greeter, lock screen, and PAM
When = PostTransaction
Exec = /usr/local/share/apollo/scripts/apollo-setup-lock.sh
