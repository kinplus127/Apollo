# Merged into ~/.config/kwinrc by install.sh if missing keys.
# Floating by default; enable a tiling script later (e.g. Krohnkite).

[Windows]
BorderlessMaximizedWindows=false
Placement=Centered

[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[ModifierKeyEvents]
Meta=Meta

[ElectricBorders]
TopLeft=None
Top=None
TopRight=None
Right=None
BottomRight=None
Bottom=None
BottomLeft=None
Left=None
