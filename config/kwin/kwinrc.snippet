# Copied to ~/.config/kwinrc by install.sh when that file is missing.
# Stock Breeze decoration. Floating by default.

[Windows]
BorderlessMaximizedWindows=false
Placement=Centered

[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[ModifierKeyEvents]
Meta=Meta

[ElectricBorders]
TopLeft=None
Top=None
TopRight=None
Right=None
BottomRight=None
Bottom=None
BottomLeft=None
Left=None
