#%PAM-1.0
# APOLLO_KSCREENLOCKER_PAM
# Fallback for kscreenlocker. apollo-setup-lock.sh installs this as
# /etc/pam.d/kde only when neither /etc/pam.d/kde nor /usr/lib/pam.d/kde
# already contains an auth stack. Same stack as Arch's kscreenlocker
# kde.pam. The greeter's PAM service name is "kde"; only auth is used.
auth       include      system-local-login
account    include      system-local-login
password   include      system-local-login
session    include      system-local-login
