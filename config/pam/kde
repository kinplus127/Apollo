#%PAM-1.0
# APOLLO_KSCREENLOCKER_PAM
# kscreenlocker authenticates with PAM service "kde" and only uses the auth
# group (pam_authenticate, then pam_setcred refresh). This is a screen unlock,
# not a new login, so it does not include system-local-login / system-login.
# That stack's "auth required pam_shells.so" still asks for the password and
# then fails a correct one when the login shell is not an exact /etc/shells
# entry. pam_nologin has the same shape. pam_unix is sufficient here.
# faillock treats EACCES as success, so a user-owned greeter is not stuck
# when it cannot create /run/faillock, and repeated failures still count
# when the tally file is writable.
auth       required                    pam_faillock.so      preauth
auth       [success=1 default=bad]     pam_unix.so          try_first_pass nullok
auth       [default=die]               pam_faillock.so      authfail
auth       required                    pam_faillock.so      authsucc
account    required                    pam_unix.so
password   required                    pam_unix.so          try_first_pass nullok shadow
session    required                    pam_unix.so
